<%= turbo_stream_from "timeline" %>

<div class="h-screen w-full bg-slate-50 flex flex-col pt-12 overflow-hidden">
  <div class="text-center mb-10 shrink-0">
    <h1 class="text-4xl font-extrabold text-slate-800 tracking-tight">Our Family Story</h1>
    <p class="text-slate-500 mt-2 text-lg">A timeline of our chapters</p>
  </div>

  <div class="flex-1 w-full flex items-center overflow-x-auto snap-x snap-mandatory hide-scrollbars pb-12"
       data-controller="scroll-center">
    
    <% current_year = Date.today.year %>
    
    <!-- Timeline Line -->
    <div class="flex items-center px-[50vw] min-w-max h-full">
      
      <% @chapters_by_year.keys.sort.each do |year| %>
        <div class="flex flex-col items-center justify-start h-full shrink-0 snap-center relative w-[24rem]"
             <%= 'data-scroll-center-target="currentYear"' if year == current_year %>>
             
             <!-- Year Marker -->
             <div class="text-5xl font-black <%= year == current_year ? 'text-indigo-600' : 'text-slate-300' %> mb-6 mt-10">
               <%= year %>
             </div>
             
             <!-- The Dot on the line -->
             <div class="w-6 h-6 rounded-full border-4 border-white shadow-md z-10 <%= year == current_year ? 'bg-indigo-600' : 'bg-slate-300' %> relative">
                <!-- Line behind dot bridging across -->
                <div class="absolute top-[6px] left-[14px] w-[24rem] h-1 bg-slate-200 -z-10"></div>
             </div>
             
             <!-- Chapters Container for the Year -->
             <div id="chapters_year_<%= year %>" class="mt-8 flex flex-col space-y-6 w-80 relative pt-4">
               <% @chapters_by_year[year].each do |chapter| %>
                 <%= render chapter %>
               <% end %>
               
               <% if @chapters_by_year[year].empty? %>
                 <div class="text-slate-400 italic text-center p-4 bg-white/50 rounded-xl border border-dashed border-slate-300">No chapters yet</div>
               <% end %>
             </div>
             
        </div>
      <% end %>
      
      <!-- Fallback if timeline is totally empty -->
      <% if @chapters_by_year.empty? %>
        <div class="flex flex-col items-center justify-start h-full shrink-0 snap-center relative w-[24rem]" data-scroll-center-target="currentYear">
          <div class="text-5xl font-black text-indigo-600 mb-6 mt-10"><%= current_year %></div>
          <div class="w-6 h-6 rounded-full border-4 border-white shadow-md z-10 bg-indigo-600 relative"></div>
          <div id="chapters_year_<%= current_year %>" class="mt-8 flex flex-col space-y-6 w-80 relative pt-4">
            <div class="text-slate-400 italic text-center p-4 bg-white/50 rounded-xl border border-dashed border-slate-300">Your timeline is empty. Start a chapter!</div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<style>
/* Hide scrollbar for Chrome, Safari and Opera */
.hide-scrollbars::-webkit-scrollbar {
  display: none;
}
/* Hide scrollbar for IE, Edge and Firefox */
.hide-scrollbars {
  -ms-overflow-style: none;  /* IE and Edge */
  scrollbar-width: none;  /* Firefox */
}
</style>
