<div class="shrink-0 snap-center px-6 relative z-10 flex flex-col items-center justify-center" id="<%= dom_id(chapter) %>_wrapper">
  <%
    entries_count = chapter.total_entries_count
    size_class = case entries_count
                 when 0..5 then "w-28 h-28 text-sm"
                 when 6..20 then "w-36 h-36 text-base"
                 when 21..50 then "w-44 h-44 text-lg"
                 else "w-52 h-52 text-xl"
                 end
  %>
  <%= link_to chapter_path(chapter), id: dom_id(chapter), data: { turbo_frame: "modal" }, class: "group relative flex flex-col items-center justify-center rounded-full bg-white shadow-md border border-slate-200 hover:shadow-xl hover:border-indigo-300 hover:scale-105 transition-all duration-300 #{size_class}" do %>
    <span class="font-bold text-slate-800 text-center px-4 line-clamp-3 leading-tight group-hover:text-indigo-600 transition-colors"><%= chapter.title %></span>
    <span class="text-xs font-medium text-slate-400 mt-2"><%= chapter.start_date&.strftime("%b %Y") || "TBD" %></span>
    
    <% if entries_count > 0 %>
      <div class="absolute top-1 right-1 bg-indigo-500 text-white text-[11px] font-bold px-2 py-1 rounded-full shadow-sm border-2 border-white">
        <%= entries_count %>
      </div>
    <% end %>
  <% end %>
</div>
