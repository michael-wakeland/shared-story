<%= form_with(model: chapter, class: "space-y-5") do |form| %>
  <% if chapter.errors.any? %>
    <div class="bg-red-50 text-red-500 p-4 rounded-xl text-sm mb-5">
      <h4 class="font-semibold mb-1"><%= pluralize(chapter.errors.count, "error") %> prohibited this chapter from being saved:</h4>
      <ul class="list-disc pl-5 space-y-1">
        <% chapter.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, class: "block text-sm font-semibold text-slate-700 mb-1" %>
    <%= form.text_field :title, class: "block w-full rounded-lg border-slate-200 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-4 py-2", placeholder: "e.g., Summer Vacation 2026" %>
  </div>

  <div>
    <%= form.label :description, class: "block text-sm font-semibold text-slate-700 mb-1" %>
    <%= form.text_area :description, rows: 3, class: "block w-full rounded-lg border-slate-200 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-4 py-2", placeholder: "A brief summary of this chapter..." %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= form.label :start_date, class: "block text-sm font-semibold text-slate-700 mb-1" %>
      <%= form.date_field :start_date, class: "block w-full rounded-lg border-slate-200 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-4 py-2" %>
    </div>

    <div>
      <%= form.label :end_date, class: "block text-sm font-semibold text-slate-700 mb-1" %>
      <%= form.date_field :end_date, class: "block w-full rounded-lg border-slate-200 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm px-4 py-2" %>
    </div>
  </div>

  <div class="flex items-center gap-2 pt-2">
    <%= form.check_box :published, class: "h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-600" %>
    <%= form.label :published, class: "text-sm font-medium text-slate-700 cursor-pointer" %>
  </div>

  <div class="pt-4 flex items-center justify-end gap-3">
    <button type="button" class="px-4 py-2 text-sm font-medium text-slate-700 bg-white border border-slate-300 rounded-lg shadow-sm hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 transition-colors cursor-pointer" data-action="click->modal#close">
      Cancel
    </button>
    <%= form.submit "Save Chapter", class: "px-4 py-2 text-sm font-medium text-white bg-indigo-600 border border-transparent rounded-lg shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 transition-colors cursor-pointer" %>
  </div>
<% end %>
