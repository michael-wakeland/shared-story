<%= turbo_frame_tag "modal" do %>
  <div data-controller="modal" class="relative z-50" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm transition-opacity" data-action="click->modal#close"></div>

    <div class="fixed inset-0 z-10 overflow-y-auto pointer-events-none">
      <div class="flex min-h-full items-center justify-center p-4 text-center sm:p-0">
        <div class="relative transform overflow-hidden rounded-2xl bg-white text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-lg pointer-events-auto">
          
          <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100">
            <h3 class="text-xl font-bold text-slate-800" id="modal-title">New Chapter</h3>
            <button type="button" class="text-slate-400 hover:text-slate-600 transition-colors bg-transparent border-0 cursor-pointer p-2 rounded-full hover:bg-slate-100" data-action="click->modal#close">
              <i class="fa-solid fa-xmark text-lg"></i>
            </button>
          </div>

          <div class="px-6 py-6">
            <%= render "form", chapter: @chapter %>
          </div>
          
        </div>
      </div>
    </div>
  </div>
<% end %>
